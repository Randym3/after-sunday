# Local development Postgres (see docker-compose.yml). Host port 5433 because
# a native Postgres 17 already occupies 5432 on this machine.
DATABASE_URL=postgresql+psycopg://after_sunday:after_sunday@localhost:5433/after_sunday

# Supabase project — used to verify bearer tokens via GET /auth/v1/user.
# Both values are publishable (public) and already live in web/.env.local.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Modulate Velma Transcribe API key. When set, real transcription runs
# through Velma (speaker diarization on). Leave empty to use the mock
# provider (dev only). Get a key at https://modulate.ai
MODULATE_API_KEY=

# Text LLM for follow-up draft generation. Any OpenAI-compatible endpoint
# works via the openai SDK (Groq is the default; OpenRouter, GitHub Models,
# NVIDIA NIM all speak the same protocol). Leave LLM_API_KEY empty to use
# the mock provider (dev only). Get a Groq key at https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Resend test email delivery. The sender must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=After Sunday <noreply@your-domain.example>

# Master key used to encrypt sensitive in-app settings (like the Resend key
# saved via the Settings page) at rest in Postgres. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# When empty, sensitive settings are stored in plaintext (dev only).
# WARNING: changing this later invalidates already-encrypted saved settings.
SECRET_KEY=

# Where the local-disk storage backend keeps uploaded files (relative to api/).
STORAGE_ROOT=storage

# Origin of the frontend web app, allowed for CORS. Local dev default;
# production sets this to the public HTTPS origin (e.g. https://app.example.com).
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Production (Oracle VM) values — see deploy/.env.production.example.
# In the production compose stack the database is reached by service name:
#   DATABASE_URL=postgresql+psycopg://after_sunday:<password>@db:5432/after_sunday
# and STORAGE_ROOT is absolute:
#   STORAGE_ROOT=/opt/after-sunday-data/storage
# ---------------------------------------------------------------------------
