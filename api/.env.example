# Local development Postgres (see docker-compose.yml). Host port 5433 because
# a native Postgres 17 already occupies 5432 on this machine.
DATABASE_URL=postgresql+psycopg://after_sunday:after_sunday@localhost:5433/after_sunday

# Supabase project — used to verify bearer tokens via GET /auth/v1/user.
# Both values are publishable (public) and already live in web/.env.local.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
