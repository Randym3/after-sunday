# After Sunday production reverse proxy. Caddy terminates HTTPS and routes:
#   /api/*  -> FastAPI (prefix stripped, so routes like /sermons are unchanged)
#   /media/* -> FastAPI (uploaded media in dev; CDN later)
#   everything else -> Next.js
#
# Replace app.example.com with the real hostname and mount this file into the
# caddy service (see docker-compose.production.yml). Caddy obtains and renews
# the certificate automatically once DNS + ports 80/443 are reachable.

app.example.com {
	encode gzip zstd

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle /media/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
